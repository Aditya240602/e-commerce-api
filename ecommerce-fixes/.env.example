# Copy this file to .env and fill in your real values.
# .env.example is safe to commit — it contains no real secrets.
# .env is NOT safe to commit — it's already in .gitignore.

# MongoDB Atlas
MONGODB_USERNAME=your_atlas_username
MONGODB_PASSWORD=your_atlas_password
MONGODB_URI=mongodb+srv://your_atlas_username:your_atlas_password@your-cluster.mongodb.net/ecommerce?appName=Cluster0

# Auth
# Generate with: openssl rand -hex 32
JWT_SECRET=your_long_random_secret_here

# Server
BASE_URL=http://localhost:3000
PORT=3000

# PayPal (sandbox/test credentials — get from developer.paypal.com)
T_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
T_PAYPAL_SECRET=your_paypal_sandbox_secret

# Stripe (test key — starts with sk_test_)
STRIPE_SECRET_KEY=your_stripe_test_key
